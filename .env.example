# ---- Admin login (required in production) ----
ADMIN_EMAIL=admin@rosieatelier.com
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random string used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET=

# ---- Content persistence (pick ONE; leave empty to use data/content.json on disk) ----
# Option A: Upstash Redis (Vercel Marketplace → Upstash → creates these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B: Vercel Blob (Vercel → Storage → Blob → creates this automatically)
BLOB_READ_WRITE_TOKEN=
